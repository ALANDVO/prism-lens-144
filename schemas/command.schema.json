{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cursor.com/schemas/command.schema.json",
  "title": "Cursor Plugin Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "Command identifier. Lowercase letters, numbers, and hyphens only. Must match parent folder name."
    },
    "displayName": {
      "type": "string",
      "description": "Human-readable display name for the command."
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "description": "Command description (max 1024 characters)."
    },
    "icon": {
      "type": "string",
      "description": "Relative path to command icon (PNG/SVG)."
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "type"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Argument identifier."
          },
          "description": {
            "type": "string",
            "description": "Argument description."
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean"],
            "description": "Argument type."
          },
          "required": {
            "type": "boolean",
            "default": false,
            "description": "Whether the argument is required."
          },
          "default": {
            "description": "Default value for the argument."
          }
        }
      },
      "description": "Command arguments."
    }
  }
}