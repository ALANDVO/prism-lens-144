{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cursor.com/schemas/plugin.schema.json",
  "title": "Cursor Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
      "description": "Plugin identifier. Lowercase letters, numbers, hyphens, and dots only."
    },
    "displayName": {
      "type": "string",
      "description": "Human-readable display name for the plugin."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?$",
      "description": "Semantic version string."
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "description": "Plugin description (max 1024 characters)."
    },
    "author": {
      "type": "string",
      "description": "Plugin author name or organization."
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier."
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "description": "Plugin source repository URL."
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Plugin homepage URL."
    },
    "icon": {
      "type": "string",
      "description": "Relative path to plugin icon (PNG/SVG, 128x128 recommended)."
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Relative paths to skill directories (each must contain SKILL.md)."
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Relative paths to agent markdown files."
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Relative paths to command directories."
    },
    "hooks": {
      "type": "string",
      "description": "Relative path to hooks.json file."
    },
    "mcpServers": {
      "type": "string",
      "description": "Relative path to mcp.json file."
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Relative paths to rule files."
    },
    "variables": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "string",
          "description": "Variable description for user configuration."
        }
      },
      "description": "Configuration variables for the plugin (referenced as ${VAR} in mcp.json)."
    }
  }
}
